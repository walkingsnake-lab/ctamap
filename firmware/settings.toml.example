# Copy to CIRCUITPY/settings.toml and fill in. Networks are tried in order;
# the phone hotspot last (spec §10).
WIFI_SSID_1 = "home-network"
WIFI_PASSWORD_1 = "..."
WIFI_SSID_2 = "work-visitor"
WIFI_PASSWORD_2 = "..."
WIFI_SSID_3 = "Jake's iPhone"
WIFI_PASSWORD_3 = "..."

BOARD_URL = "https://ctamap.fly.dev"
# One ID per physical board: boards sharing an ID show the same thing. A new
# ID adds itself on the server (as a copy of "home") the first time it connects.
BOARD_ID = "home"
# Same value as the BOARD_TOKEN Fly secret.
BOARD_TOKEN = "..."

# Panel color depth (1-6). Higher = smoother dim colors, more flicker risk.
MATRIX_BIT_DEPTH = 5

# Panel rotation: 0, or 180 when the panel is mounted upside down (Matrix
# Portal on the other side). The UP/DOWN buttons keep their screen order.
MATRIX_ROTATION = 0

# Gamma applied to every palette color (the panel is linear; colors are
# authored for screens). "1" = off. Try "1.8", then "2.2". Quoted: settings.toml
# has no floats.
MATRIX_GAMMA = "1.8"

# Status NeoPixel (on the board, behind the panel): 2 = every state, including
# blue during each request; 1 = errors and connecting only; 0 = always off.
STATUS_LED = 2
